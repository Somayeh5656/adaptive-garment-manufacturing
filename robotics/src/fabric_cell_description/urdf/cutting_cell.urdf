<?xml version="1.0"?>
<!--
    URDF model of the simple 2‑DOF robotic cutting cell.
    Used in Gazebo Harmonic with ros2_control for velocity control.
    The controller configuration file is expected at
    ../config/controller.yaml relative to this URDF file after installation.
-->
<robot name="cutting_cell">

    <material name="blue">
        <color rgba="0.1 0.1 0.7 1.0"/>
    </material>
    <material name="grey">
        <color rgba="0.5 0.5 0.5 1.0"/>
    </material>
    <material name="red">
        <color rgba="0.9 0.1 0.1 1.0"/>
    </material>

    <!-- Base -->
    <link name="base_link">
        <visual>
            <geometry>
                <box size="0.4 0.4 0.1"/>
            </geometry>
            <material name="grey"/>
        </visual>
        <collision>
            <geometry>
                <box size="0.4 0.4 0.1"/>
            </geometry>
        </collision>
        <inertial>
            <mass value="10.0"/>
            <inertia ixx="0.1" ixy="0" ixz="0" iyy="0.1" iyz="0" izz="0.1"/>
        </inertial>
    </link>

    <!-- Column -->
    <link name="column_link">
        <visual>
            <geometry>
                <cylinder length="0.6" radius="0.08"/>
            </geometry>
            <material name="blue"/>
            <origin xyz="0 0 0.3"/>
        </visual>
        <collision>
            <geometry>
                <cylinder length="0.6" radius="0.08"/>
            </geometry>
        </collision>
        <inertial>
            <mass value="5.0"/>
            <inertia ixx="0.05" ixy="0" ixz="0" iyy="0.05" iyz="0" izz="0.05"/>
        </inertial>
    </link>

    <joint name="base_to_column" type="fixed">
        <parent link="base_link"/>
        <child link="column_link"/>
        <origin xyz="0 0 0.05"/>
    </joint>

    <!-- Shoulder -->
    <link name="shoulder_link">
        <visual>
            <geometry>
                <box size="0.5 0.1 0.1"/>
            </geometry>
            <material name="blue"/>
        </visual>
        <collision>
            <geometry>
                <box size="0.5 0.1 0.1"/>
            </geometry>
        </collision>
        <inertial>
            <mass value="3.0"/>
            <inertia ixx="0.02" ixy="0" ixz="0" iyy="0.02" iyz="0" izz="0.02"/>
        </inertial>
    </link>

    <joint name="shoulder_joint" type="revolute">
        <parent link="column_link"/>
        <child link="shoulder_link"/>
        <origin xyz="0 0 0.6"/>
        <axis xyz="0 1 0"/>
        <limit lower="-1.57" upper="1.57" effort="50" velocity="1.0"/>
    </joint>

    <!-- Arm -->
    <link name="arm_link">
        <visual>
            <geometry>
                <box size="0.5 0.08 0.08"/>
            </geometry>
            <material name="blue"/>
            <origin xyz="0.25 0 0"/>
        </visual>
        <collision>
            <geometry>
                <box size="0.5 0.08 0.08"/>
            </geometry>
        </collision>
        <inertial>
            <mass value="2.0"/>
            <inertia ixx="0.01" ixy="0" ixz="0" iyy="0.01" iyz="0" izz="0.01"/>
        </inertial>
    </link>

    <joint name="elbow_joint" type="revolute">
        <parent link="shoulder_link"/>
        <child link="arm_link"/>
        <origin xyz="0.25 0 0"/>
        <axis xyz="0 1 0"/>
        <limit lower="-1.57" upper="1.57" effort="50" velocity="1.0"/>
    </joint>

    <!-- Tool -->
    <link name="tool_link">
        <visual>
            <geometry>
                <box size="0.1 0.05 0.05"/>
            </geometry>
            <material name="red"/>
            <origin xyz="0.5 0 0"/>
        </visual>
        <collision>
            <geometry>
                <box size="0.1 0.05 0.05"/>
            </geometry>
        </collision>
        <inertial>
            <mass value="0.5"/>
            <inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001"/>
        </inertial>
    </link>

    <joint name="arm_to_tool" type="fixed">
        <parent link="arm_link"/>
        <child link="tool_link"/>
        <origin xyz="0.5 0 0"/>
    </joint>

    <!-- Gazebo plugin for ros2_control (Gazebo Harmonic) -->
    <gazebo>
        <plugin filename="gz_ros2_control-system" name="gz_ros2_control::GazeboSimControl">
            <!-- Path relative to the installed URDF's directory (urdf/),
                 points to config/controller.yaml in the same package -->
            <parameters>../config/controller.yaml</parameters>
        </plugin>
    </gazebo>

    <!-- ros2_control hardware interfaces -->
    <ros2_control name="CuttingCellController" type="system">
        <hardware>
            <plugin>gz_ros2_control/GazeboSimSystem</plugin>
        </hardware>
        <joint name="shoulder_joint">
            <command_interface name="velocity">
                <param name="min">-1.57</param>
                <param name="max">1.57</param>
            </command_interface>
            <state_interface name="position"/>
            <state_interface name="velocity"/>
        </joint>
        <joint name="elbow_joint">
            <command_interface name="velocity">
                <param name="min">-1.57</param>
                <param name="max">1.57</param>
            </command_interface>
            <state_interface name="position"/>
            <state_interface name="velocity"/>
        </joint>
    </ros2_control>

</robot>