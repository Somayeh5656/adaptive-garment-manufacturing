<?xml version="1.0" ?>
<!--
    Gazebo world for the robotic cutting cell.
    Contains a ground plane, table, red fabric piece, and a top‑down camera
    that publishes to /camera/image_raw.
    This file is launched by fabric_cell_bringup/gazebo_simulation.launch.py.
-->
<sdf version="1.6">
  <world name="cutting_cell">
    <!-- Physics -->
    <physics name="default" type="ode">
      <gravity>0 0 -9.8</gravity>
    </physics>

    <!-- Ambient lighting -->
    <scene>
      <ambient>0.4 0.4 0.4 1</ambient>
      <background>0.7 0.7 0.7 1</background>
    </scene>

    <!-- Directional sun (to light the scene) -->
    <light name="sun" type="directional">
      <pose>0 0 10 0 0 0</pose>
      <direction>0 0 -1</direction>
      <diffuse>0.8 0.8 0.8 1</diffuse>
    </light>

    <!-- Ground plane (infinite floor) -->
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>10 10</size>
            </plane>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>10 10</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.5 0.5 0.5 1</ambient>
          </material>
        </visual>
      </link>
    </model>

    <!-- Table where the fabric lies -->
    <model name="table">
      <static>true</static>
      <pose>0.5 0 0 0 0 0</pose>
      <link name="table_link">
        <visual name="visual">
          <geometry>
            <box>
              <size>1.2 1.0 0.05</size>
            </box>
          </geometry>
          <material>
            <ambient>0.6 0.4 0.2 1</ambient>
          </material>
        </visual>
        <collision name="collision">
          <geometry>
            <box>
              <size>1.2 1.0 0.05</size>
            </box>
          </geometry>
        </collision>
      </link>
    </model>

    <!-- Red fabric piece (rigid box for simulation) -->
    <model name="fabric_piece">
      <static>true</static>
      <pose>0.5 0 0.03 0 0 0</pose>
      <link name="fabric_link">
        <visual name="visual">
          <geometry>
            <box>
              <size>0.4 0.3 0.002</size>
            </box>
          </geometry>
          <material>
            <ambient>0.8 0.2 0.2 1</ambient>
          </material>
        </visual>
        <collision name="collision">
          <geometry>
            <box>
              <size>0.4 0.3 0.002</size>
            </box>
          </geometry>
        </collision>
      </link>
    </model>

    <!-- Camera looking down at the table -->
    <model name="camera">
      <static>true</static>
      <pose>0.8 0.5 0.8 0 0.2 0</pose>
      <link name="camera_link">
        <sensor name="camera_sensor" type="camera">
          <camera>
            <horizontal_fov>1.0</horizontal_fov>
            <image>
              <width>640</width>
              <height>480</height>
              <format>R8G8B8</format>
            </image>
            <clip>
              <near>0.1</near>
              <far>10</far>
            </clip>
          </camera>
          <always_on>1</always_on>
          <update_rate>30</update_rate>
          <visualize>true</visualize>
          <topic>/camera/image_raw</topic>
        </sensor>
      </link>
    </model>
  </world>
</sdf>